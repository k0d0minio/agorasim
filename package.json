{
  "name": "agorasim-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Toolkit for operating the Agorasim business: the website (web/) and ICM operations workspaces (workspaces/).",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "typecheck": "pnpm --filter web typecheck"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "undici@>=6.7.0 <6.28.1": "^6.28.1",
      "undici@>=7.0.0 <7.29.1": "^7.29.1"
    }
  }
}
