{
  "name": "agorasim-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Toolkit for operating the Agorasim business: the website (web/) and ICM operations workspaces (workspaces/).",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "typecheck": "pnpm --filter web typecheck"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    }
  }
}
