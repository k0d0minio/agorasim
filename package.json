{
  "name": "agorasim-toolkit",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "description": "Toolkit for operating the Agorasim business: the website (web/) and ICM operations workspaces (workspaces/).",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test",
    "typecheck": "pnpm --filter web typecheck",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:verify": "pnpm --filter web db:verify",
    "seed:test-roles": "pnpm --filter web seed:test-roles"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "react": "19.2.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
