# Names only. Every value lives in Vercel (per environment), in the repository's Actions secrets
# and variables, or in a local .env.local that git never sees. The note above each name and the
# [environments] suffix are the contract (.icm/_system/features/uat.md, .icm/local/database.md). Add the application's own names below.

# The Neon connection string, pooled. On Vercel the Neon integration sets Production's and each
# preview's, and the `uat` environment's from the UAT project uat-agorasim. In Actions: production's
# direct string, read by migrate-production.yml only. Locally: a branch of your own, never
# production's. The application's own names are in web/.env.example.  [production,preview,uat,ci,development]
DATABASE_URL=
# The direct (unpooled) string of the same branch, for the migrations at build.  [production,preview,uat]
DATABASE_URL_UNPOOLED=

# Read by .icm/_system/scripts/*.sh and the workflows, never by the application. VERCEL_TOKEN is an Actions
# secret. VERCEL_TEAM (kodominio) and NEON_PROJECT_ID (the UAT project uat-agorasim,
# lingering-frog-97017403) are Actions variables. VERCEL_PROJECT stays unset: the Vercel project is
# named as the repository.  [ci,shell]
VERCEL_TOKEN=
VERCEL_TEAM=
VERCEL_PROJECT=
NEON_API_KEY=
NEON_PROJECT_ID=
