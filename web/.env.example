# ---------------------------------------------------------------------------
# Agorasim web — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled URL from the Neon dashboard).
# Used by Drizzle at runtime (server actions / server components) and by
# `drizzle-kit migrate` in the GitHub "DB migrate" workflow.
# Example: postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin area (see src/lib/admin-session.ts and src/lib/admin-auth.ts)
# ---------------------------------------------------------------------------

# The HMAC key that signs admin session cookies. REQUIRED in every environment,
# including local development — there is no built-in fallback, so a misconfigured
# deployment fails closed rather than minting sessions with a public secret.
# Rotating it invalidates every live session.
#
#   cd web
#   printf 'ADMIN_SESSION_SECRET=%s\n' "$(openssl rand -base64 32)" >> .env.local
ADMIN_SESSION_SECRET=

# The first owner account, used by `pnpm db:seed-owner` so a fresh deployment is
# never locked out of its own admin. Seeding is idempotent: if the address
# already has an account it is left completely alone, password included.
#
#   cd web
#   ADMIN_SEED_EMAIL=diogo@agorasim.pt ADMIN_SEED_NAME=Diogo \
#   ADMIN_SEED_PASSWORD='a long passphrase' pnpm db:seed-owner
#
# The password must be at least 12 characters (src/lib/password-policy.ts) and
# should be changed from /admin/settings/account on first sign-in.
#
# These are the *only* route to a first account. The login form authenticates
# against `admin_users` and nothing else — the old shared `ADMIN_PASSWORD` is
# gone, so a deployment with an empty table and no seed secrets has no way in
# and has to be seeded from a database console.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Data retention (see src/lib/retention.ts and docs/data-protection.md)
# ---------------------------------------------------------------------------

# How long an enquiry that never converted is kept before the scheduled job
# anonymises it. Whole days.
#
# ⚠️ 730 (24 months) is the fallback if unset, and it is a PROPOSAL that nobody
# has signed off. Set this explicitly once the period has actually been decided.
ENQUIRY_RETENTION_DAYS=730

# How long an audit entry keeps the IP address it was recorded from, before the
# same job nulls it. Whole days. The entry itself is kept — only this one field
# expires.
#
# 90 is the fallback, and unlike the period above it is a recommendation rather
# than a placeholder: the usual window for security logs, long enough to
# investigate an incident somebody noticed late, short enough that the column is
# not a standing record of where the team works from.
AUDIT_IP_RETENTION_DAYS=90

# Shared secret for the scheduled retention route (/api/cron/retention). Vercel
# Cron sends it as `Authorization: Bearer $CRON_SECRET`. Without it the route
# refuses every request rather than running open — it deletes personal data, so
# an unauthenticated version of it would be a weapon pointed at the sales
# pipeline.
#
#   printf 'CRON_SECRET=%s\n' "$(openssl rand -base64 32)" >> .env.local
CRON_SECRET=

# ---------------------------------------------------------------------------
# Third parties
# ---------------------------------------------------------------------------

# Vercel Blob, where experience photos uploaded from /admin/experiences are
# stored. On Vercel the token appears automatically once a Blob store is
# connected to the project (Storage → Create → Blob); for local development,
# copy it from the store's settings.
#
# When unset, the rest of the catalogue editor keeps working — only uploads
# fail, with an inline message telling the operator storage isn't configured.
# Rows keep whatever image they already have.
BLOB_READ_WRITE_TOKEN=

# FareHarbor booking lightbox (optional). When empty, booking CTAs fall back
# to the contact page. When set, the embed script still only loads after the
# visitor accepts the cookie notice — see docs/cookies-and-third-parties.md.
NEXT_PUBLIC_FAREHARBOR_SHORTNAME=
