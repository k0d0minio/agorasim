# ---------------------------------------------------------------------------
# Agorasim web — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled URL from the Neon dashboard).
# Used by Drizzle at runtime (server actions / server components) and by
# `drizzle-kit migrate` in the GitHub "DB migrate" workflow.
# Example: postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Admin area (see src/lib/admin-auth.ts).
#
# BOTH are required in EVERY environment, including local development — there
# are no built-in fallbacks. Without them the admin area fails closed: the login
# form rejects every password and no session can be minted.
#
# ADMIN_PASSWORD      the single shared password for the team (Diogo & Rita).
# ADMIN_SESSION_SECRET the HMAC key that signs session cookies. Rotating it
#                      invalidates every live session.
#
# For local development, generate throwaway values into .env.local:
#
#   cd web
#   printf 'ADMIN_PASSWORD=%s\n' "$(openssl rand -base64 18)" >> .env.local
#   printf 'ADMIN_SESSION_SECRET=%s\n' "$(openssl rand -base64 32)" >> .env.local
#
# In production set both in the Vercel project's environment variables. Never
# reuse the local values, and never commit either of them.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# FareHarbor booking lightbox (optional). When empty, booking CTAs fall back
# to the contact page.
NEXT_PUBLIC_FAREHARBOR_SHORTNAME=
