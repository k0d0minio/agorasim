{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/dispatch",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 2 * * *"
    }
  ]
}
