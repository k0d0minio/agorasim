{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm --filter:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh label:*)",
      "Bash(gh auth status:*)",
      "Bash(gh api:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(.icm/scripts/resolve-run.sh:*)",
      "Bash(.icm/scripts/new-run.sh:*)",
      "Bash(.icm/scripts/project-body.sh:*)",
      "Bash(.icm/scripts/project-labels.sh:*)",
      "Bash(.icm/scripts/validate-spec.sh:*)",
      "Bash(.icm/scripts/validate-intake.sh:*)",
      "Bash(.icm/scripts/validate-decisions.sh:*)",
      "Bash(.icm/scripts/validate-knowledge-map.sh:*)",
      "Bash(.icm/scripts/triage-report.sh:*)",
      "Bash(.icm/scripts/ci-status.sh:*)",
      "Bash(.icm/scripts/close-out.sh:*)",
      "Bash(.icm/scripts/env-check.sh:*)",
      "Bash(.icm/scripts/format.sh:*)",
      "Bash(.icm/scripts/lint.sh:*)",
      "Bash(.icm/scripts/notify.sh:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(jq:*)",
      "Bash(command -v:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wrap-reminder.sh"
          }
        ]
      }
    ]
  }
}
